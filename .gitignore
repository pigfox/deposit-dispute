# Secrets — live here and in ../.env; NEVER committed.
.env
.env.*
!.env.example

# Nothing key-shaped is ever committed. These patterns are belt-and-braces on top
# of the rule, not a substitute for it: no key, keystore, mnemonic or certificate
# is written into this tree in the first place.
*.key
*.pem
*.p12
*.pfx
*.keystore
*.mnemonic
secrets.json
keystore/

# Foundry build output
out/
cache/
lcov.info
coverage-report/
coverage-summary.txt

# forge deploy artifacts. Deployed addresses are transcribed into
# deployments/base-sepolia.json + the README instead of committing this.
broadcast/

# Property-fuzzing working state. The CORPORA are regenerable and machine-local;
# committing them would let a stale corpus decide what a fresh run explores. The
# engine transcripts are inputs to the property-count gate, not artifacts.
echidna-corpus/
medusa-corpus/
crytic-export/
echidna-output.txt
medusa-output.txt
slither_results.json

# Go coverage output, for when the adjudicator service lands.
adjudicator/coverage.out

# Node (only present if a helper toolchain is added later)
node_modules/
npm-debug.log*

# Claude Code local settings
.claude/settings.local.json

# Session tag (convention v1). Local to the working copy, never committed.
.session-tag
