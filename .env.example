# deposit-dispute — every variable this repo reads, and nothing else.
#
# Copy to .env and fill in. .env is gitignored and NOTHING in it is ever
# committed, logged, echoed or put in an error message. The rule throughout this
# repo is that a variable is NAMED and a value never is.
#
#   ./scripts/with-env.sh 'CMD'   sources .env and runs CMD without echoing it.

# --- chain -------------------------------------------------------------------

# Base Sepolia endpoint. DIRECT-CHAIN ONLY: the adjudicator reads the chain id
# back and refuses to run against anything that is not 84532, and the deploy
# script has no other target. Shared by forge and by the adjudicator so there is
# one endpoint rather than two variables that can drift apart.
RPC_URL=

# The deploying key. Holds the two deposits (0.0022 ether total) plus gas,
# because a DepositDispute takes custody at construction and has no later
# funding path.
DEMO_DEPLOYER_PK=

# Basescan, for contract verification after deployment.
ETHERSCAN_API_KEY=

# --- the parties -------------------------------------------------------------

# The landlord files the claim and is credited established deductions.
DD_LANDLORD_ADDR=
DD_LANDLORD_PK=

# The tenant is credited whatever the landlord did not establish.
DD_TENANT_ADDR=
DD_TENANT_PK=

# --- the three adjudicator slots ---------------------------------------------
#
# Each slot has an ADDRESS that signs its verdicts on chain and a MODEL that
# answers off chain. The contract is constructed with the addresses and with
# keccak256 of the model identifiers; the adjudicator reads those hashes back and
# REFUSES TO RUN if they do not match what it is configured with. So these are
# written once, here, and both halves read them.
#
# The three models must be DISTINCT (three copies of one model agree trivially)
# and must span MORE THAN ONE VENDOR — the contract can check the first and
# cannot check the second, because it sees hashes and has no idea which company
# serves them.

DD_SLOT0_PROVIDER=anthropic
DD_SLOT0_MODEL_ID=
DD_SLOT0_SIGNER_ADDR=
DD_SLOT0_SIGNER_PK=

DD_SLOT1_PROVIDER=openai
DD_SLOT1_MODEL_ID=
DD_SLOT1_SIGNER_ADDR=
DD_SLOT1_SIGNER_PK=

DD_SLOT2_PROVIDER=anthropic
DD_SLOT2_MODEL_ID=
DD_SLOT2_SIGNER_ADDR=
DD_SLOT2_SIGNER_PK=

# Whether the temperature field goes on the wire for a slot. Optional; defaults
# to true.
#
# THE VALUE IS ALWAYS ZERO AND IS NOT CONFIGURABLE ANYWHERE. What is configurable
# is whether the field is SENT, because that is a fact about a vendor's API
# rather than a setting: some models reject the field outright, and a request
# carrying a parameter the model refuses does not run warm — it does not run.
# Set to false for such a slot.
#
# DD_SLOT0_SEND_TEMPERATURE=true
# DD_SLOT1_SEND_TEMPERATURE=true
# DD_SLOT2_SEND_TEMPERATURE=true

# --- vendor keys -------------------------------------------------------------
#
# One per vendor named above. A slot whose provider has no key here is refused at
# load, by variable name, before any call is made.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- the dispute under adjudication ------------------------------------------
#
# Filled in AFTER deployment. One address per run: the adjudicator adjudicates
# one dispute, so the split and the cap are two separate runs.

DD_DISPUTE_ADDRESS=
